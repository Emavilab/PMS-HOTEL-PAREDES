# Backend
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hotel_paredes
SECRET_KEY=your-secret-key-change-in-production
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
DEBUG=true

# Supabase (optional, for cloud deployment)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# Hotel Configuration
HOTEL_NAME=Hotel Paredes
HOTEL_ADDRESS=Dirección del hotel
HOTEL_PHONE=+504 XXXX-XXXX
HOTEL_EMAIL=info@hotelparedes.com
DEFAULT_CURRENCY=HNL
DEFAULT_TAX_RATE=0.15
DEFAULT_CHECKIN_TIME=15:00
DEFAULT_CHECKOUT_TIME=12:00

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
